<%
  var _title = (typeof title !== 'undefined' && title) ? title : 'Terjadi Kesalahan';
  var _msg = (typeof message !== 'undefined' && message) ? message : 'Terjadi kesalahan saat memuat halaman ini.';
  var _code = (typeof code !== 'undefined' && code) ? code : 403;
  var _icon = _code === 404 ? 'bi-signpost-2' : (_code === 403 ? 'bi-shield-lock' : 'bi-exclamation-triangle');
%>
<div class="d-flex align-items-center justify-content-center" style="min-height:62vh;">
  <div class="text-center px-3" style="max-width:520px;">
    <div style="font-size:72px;line-height:1;color:#c7c9f5;"><i class="bi <%= _icon %>"></i></div>
    <div class="mt-3 fw-bold" style="font-size:.78rem;letter-spacing:.14em;color:#9ca3af;">ERROR <%= _code %></div>
    <h2 class="mt-1 mb-2 fw-bold" style="color:#1e1b4b;"><%= _title %></h2>
    <p class="text-muted mb-4"><%= _msg %></p>
    <a href="/" class="btn btn-primary"><i class="bi bi-house-door me-1"></i>Kembali ke Dashboard</a>
  </div>
</div>
