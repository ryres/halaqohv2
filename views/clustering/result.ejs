<div class="row mb-3">
  <div class="col-6 col-md-4 mb-3 mb-md-0">
    <div class="card p-3 border-start border-primary border-4">
      <div class="d-flex align-items-center">
        <div class="bg-primary bg-opacity-10 p-3 rounded me-3 text-primary">
          <i class="bi bi-people-fill fs-3"></i>
        </div>
        <div>
          <h6 class="text-muted mb-1">Total Data Responden</h6>
          <h3 class="mb-0" id="txtTotalData">-</h3>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 mb-3 mb-md-0">
    <div class="card p-3 border-start border-info border-4">
      <div class="d-flex align-items-center">
        <div class="bg-info bg-opacity-10 p-3 rounded me-3 text-info">
          <i class="bi bi-diagram-3-fill fs-3"></i>
        </div>
        <div>
          <h6 class="text-muted mb-1">Jumlah Klaster (k)</h6>
          <h3 class="mb-0" id="txtJumlahCluster">-</h3>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 mb-3 mb-md-0">
    <div class="card p-3 border-start border-success border-4">
      <div class="d-flex align-items-center">
        <div class="bg-success bg-opacity-10 p-3 rounded me-3 text-success">
          <i class="bi bi-shield-check fs-3"></i>
        </div>
        <div>
          <h6 class="text-muted mb-1">Silhouette Score</h6>
          <h3 class="mb-0" id="txtSilhouetteScore">0.00</h3>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12 col-lg-8">
    <div class="card p-3 mb-3 shadow-sm">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h5><i class="bi bi-scatter me-2 text-primary"></i>Scatter Plot (Clusters)</h5>
        <div class="badge-group text-end fs-7">
          <span class="badge bg-success me-1">● Tinggi</span>
          <span class="badge bg-warning text-dark me-1">● Menengah</span>
          <span class="badge bg-danger">● Rendah</span>
        </div>
      </div>
      <canvas id="scatterChart"></canvas>
    </div>
    <div class="card p-3 mb-3 shadow-sm">
      <h5><i class="bi bi-graph-up me-2 text-danger"></i>Line / Iteration (Placeholder)</h5>
      <canvas id="lineChart"></canvas>
    </div>
  </div>
  
  <div class="col-12 col-lg-4">
    <div class="card p-3 mb-3 shadow-sm">
      <h5><i class="bi bi-bar-chart me-2 text-warning"></i>Distribusi Cluster</h5>
      <canvas id="barChart"></canvas>
    </div>
    <div class="card p-3 mb-3 shadow-sm">
      <h5><i class="bi bi-speedometer2 me-2 text-info"></i>Radar - Karakteristik</h5>
      <canvas id="radarChart"></canvas>
    </div>
  </div>
</div>