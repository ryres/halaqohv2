<div class="card max-width-800 mx-auto">
  <div class="card-header" style="background:var(--primary); color:white;">
    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Santri: <%= santri.nama %></h5>
  </div>
  <div class="card-body">
    <form method="post" action="/santri/<%= santri.id %>">
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label fw-semibold">Nama</label>
          <input type="text" name="nama" class="form-control" value="<%= santri.nama %>" required />
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label fw-semibold">Kelas</label>
          <input type="text" name="kelas" class="form-control" value="<%= santri.kelas || '' %>" />
        </div>
      </div>
      
      <div class="row">
        <div class="col-md-3 mb-3">
          <label class="form-label fw-semibold">Juz</label>
          <select name="juz" class="form-control" data-selected="<%= santri.juz || '' %>"></select>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label fw-semibold">Surat</label>
          <select name="surat" class="form-control" data-selected="<%= santri.surat || '' %>"></select>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label fw-semibold">Ayat</label>
          <select name="ayat" class="form-control" data-selected="<%= santri.ayat || '' %>"></select>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label fw-semibold">Target Juz (0-30)</label>
          <input type="number" name="target_juz" class="form-control" min="0" max="30" value="<%= santri.target_juz || '' %>" />
        </div>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label fw-semibold">Tajwid (0-100)</label>
          <input type="number" name="tajwid" class="form-control" min="0" max="100" value="<%= santri.tajwid || 0 %>" />
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label fw-semibold">Kelancaran (0-100)</label>
          <input type="number" name="kelancaran" class="form-control" min="0" max="100" value="<%= santri.kelancaran || 0 %>" />
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label fw-semibold">Makhraj (0-100)</label>
          <input type="number" name="makhraj" class="form-control" min="0" max="100" value="<%= santri.makhraj || 0 %>" />
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label fw-semibold">Halaqoh</label>
          <select name="halaqoh_id" class="form-control">
            <option value="">-- Pilih Halaqoh --</option>
            <% halaqohs.forEach(h => { %>
              <option value="<%= h.id %>" <%= santri.halaqoh_id == h.id ? 'selected' : '' %>><%= h.nama_halaqoh %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label fw-semibold">Guru</label>
          <select name="guru_id" class="form-control">
            <option value="">-- Pilih Guru --</option>
            <% gurus.forEach(g => { %>
              <option value="<%= g.id %>" <%= santri.guru_id == g.id ? 'selected' : '' %>><%= g.nama %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <hr>
      <div class="d-flex justify-content-end gap-2">
        <a href="/santri" class="btn btn-secondary">Batal</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>
<script>
(function() {
  const surahs = <%- JSON.stringify(surahsData || []) %>;
  
  function initSelects() {
    const juzSelect = document.querySelector('select[name="juz"]');
    const suratSelect = document.querySelector('select[name="surat"]');
    const ayatSelect = document.querySelector('select[name="ayat"]');

    if (juzSelect) {
      const selectedJuz = juzSelect.getAttribute('data-selected');
      juzSelect.innerHTML = '<option value="">-- Pilih Juz --</option>';
      for (let i = 1; i <= 30; i++) {
        juzSelect.innerHTML += `<option value="${i}" ${selectedJuz == i ? 'selected' : ''}>${i}</option>`;
      }
    }

    if (suratSelect) {
      const selectedSurat = suratSelect.getAttribute('data-selected');
      suratSelect.innerHTML = '<option value="">-- Pilih Surat --</option>';
      surahs.forEach((s) => {
        suratSelect.innerHTML += `<option value="${s.name}" ${selectedSurat == s.name ? 'selected' : ''}>${s.name}</option>`;
      });

      suratSelect.addEventListener('change', function() {
        updateAyatSelect(this.value);
      });
      
      if (selectedSurat && ayatSelect) {
        updateAyatSelect(selectedSurat, ayatSelect.getAttribute('data-selected'));
      } else if (!selectedSurat && ayatSelect) {
        ayatSelect.innerHTML = '<option value="">-- Pilih Ayat --</option>';
      }
    }
    
    function updateAyatSelect(suratName, selectedAyat = null) {
      if (!ayatSelect) return;
      ayatSelect.innerHTML = '<option value="">-- Pilih Ayat --</option>';
      if (!suratName) return;
      
      const surahData = surahs.find(s => s.name === suratName);
      if (surahData) {
        for (let i = 1; i <= surahData.ayahs; i++) {
          ayatSelect.innerHTML += `<option value="${i}" ${selectedAyat == i ? 'selected' : ''}>${i}</option>`;
        }
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initSelects);
})();
</script>
