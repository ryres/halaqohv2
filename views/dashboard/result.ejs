<style>
  :root {
    --primary: #6D28D9;
    --primary-light: #8B5CF6;
    --primary-dark: #4C1D95;
  }

  .result-chart-card canvas { width: 100% !important; height: 100% !important; }
  .result-chart-card .chart-wrapper { width: 100%; min-height: 280px; }
  .result-chart-card .chart-wrapper.line-chart { min-height: 220px; }
  .scatter-modal-chart-wrapper { height: min(70vh, 620px); min-height: 320px; }
  #scatterChart, #scatterChartModalCanvas { cursor: grab; }
  #scatterChart:active, #scatterChartModalCanvas:active { cursor: grabbing; }

  @media (max-width: 767px) {
    .result-chart-card .chart-wrapper { min-height: 220px; }
    .scatter-modal-chart-wrapper { height: 60vh; min-height: 260px; }
  }

  .card {
    border: none;
    border-radius: 1rem;
    box-shadow: 0 4px 20px rgba(109, 40, 217, 0.08);
    transition: box-shadow 0.2s ease;
  }
  .card:hover {
    box-shadow: 0 8px 32px rgba(109, 40, 217, 0.12);
  }

  .card h6 {
    font-weight: 700;
    color: #1e1b4b;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .btn-outline-primary {
    color: var(--primary);
    border-color: var(--primary);
  }
  .btn-outline-primary:hover {
    background-color: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }

  .btn-primary {
    background-color: var(--primary);
    border-color: var(--primary);
  }
  .btn-primary:hover {
    background-color: var(--primary-dark);
    border-color: var(--primary-dark);
  }

  .badge.bg-success { background-color: #16a34a !important; }
  .badge.bg-warning { background-color: #f59e0b !important; color: #1e1b4b !important; }
  .badge.bg-danger { background-color: #ef4444 !important; }

  #silhouetteValue { font-size: 28px; font-weight: 700; color: var(--primary); }

  .table th {
    font-weight: 600;
    color: #1e1b4b;
    border-bottom-width: 2px;
    border-bottom-color: #e5e7eb;
  }

  .table td { vertical-align: middle; }
  .cluster-dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 6px;
  }

  .table-responsive { max-height: 420px; overflow-y: auto; }
  .table-responsive::-webkit-scrollbar { width: 4px; }
  .table-responsive::-webkit-scrollbar-thumb { background: var(--primary-light); border-radius: 8px; }
  .table-responsive::-webkit-scrollbar-track { background: #f1f1f1; }
</style>

<div class="container py-4" id="resultMain">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
      <h2 class="fw-bold" style="color: var(--primary-dark);">
        <i class="bi bi-diagram-3 me-2"></i>Hasil Clustering K-Means
      </h2>
      <p class="text-muted small mb-0">
        Metode: K-Means + Manhattan Distance • Evaluasi: Silhouette Score
      </p>
    </div>
    <div>
      <span class="badge bg-primary bg-opacity-10 text-primary p-2 px-3">
        <i class="bi bi-calendar3 me-1"></i>
        <span id="generatedDate"></span>
      </span>
    </div>
  </div>

  <div class="row">
    <div class="col-12 col-lg-8">
      <div class="card p-3 mb-3">
        <h6><i class="bi bi-scatter-chart me-2"></i>Penyebaran Titik Cluster</h6>
        <div class="chart-wrapper"><canvas id="scatterChart"></canvas></div>
      </div>

      <div class="card p-3 mb-3">
        <h6><i class="bi bi-table me-2"></i>Halaqoh Tholibah</h6>
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary" id="sortByNameBtn" onclick="setTableSort('name')">
              Nama <span class="ms-1" id="sortByNameIcon"></span>
            </button>
            <button type="button" class="btn btn-outline-secondary" id="sortByLabelBtn" onclick="setTableSort('label')">
              Kategori <span class="ms-1" id="sortByLabelIcon"></span>
            </button>
            <button type="button" class="btn btn-outline-secondary" id="sortByClusterBtn" onclick="setTableSort('cluster')">
              Cluster <span class="ms-1" id="sortByClusterIcon"></span>
            </button>
          </div>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center" onclick="downloadSantriCSV()">
              <i class="bi bi-file-earmark-spreadsheet me-1"></i> CSV
            </button>
            <button type="button" class="btn btn-sm btn-danger d-flex align-items-center" onclick="downloadSantriPDF()">
              <i class="bi bi-file-pdf me-1"></i> PDF
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0" id="santriTable">
            <thead>
              <tr>
                <th class="py-2">Nama</th>
                <th class="py-2">Guru</th>
                <th class="py-2">Halaqoh</th>
                <th class="py-2">Kategori</th>
                <th class="py-2 text-center">Cluster</th>
              </tr>
            </thead>
            <tbody id="santriLabelContainer"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="card p-3 mb-3">
        <h6><i class="bi bi-bar-chart me-2"></i>Jumlah Anggota per Cluster</h6>
        <canvas id="barChart" style="max-height:280px;"></canvas>
        <div id="clusterCountSummary" class="mt-3 small"></div>
      </div>

      <div class="card p-3 mb-3">
        <h6><i class="bi bi-graph-up me-2"></i>Line Chart — Perubahan Centroid per Iterasi</h6>
        <div class="chart-wrapper line-chart"><canvas id="lineChart"></canvas></div>
      </div>

      <div class="card p-3 mb-3" style="background:#f8f9fa;">
        <h6><i class="bi bi-clipboard-data me-2"></i>Statistik</h6>
        <hr />
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted small">Silhouette Score</span>
          <span id="silhouetteValue">-</span>
        </div>
        <p id="silhouetteInterpretation" class="text-muted small mt-2 mb-0"></p>
        <hr />
        <div id="clusterStatsSummary" class="small"></div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="scatterChartModal" tabindex="-1" aria-labelledby="scatterChartModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="scatterChartModalLabel">Penyebaran Titik Cluster</h5>
        <div class="d-flex align-items-center gap-2 ms-auto">
          <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetScatterChartZoom()" title="Reset zoom">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
          </button>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
      </div>
      <div class="modal-body">
        <div class="scatter-modal-chart-wrapper"><canvas id="scatterChartModalCanvas"></canvas></div>
      </div>
    </div>
  </div>
</div>

<div id="resultEmpty" class="d-none">
  <div class="container py-5">
    <div class="text-center mx-auto" style="max-width:540px;">
      <div style="font-size:64px;line-height:1;color:#c7c9f5;"><i class="bi bi-diagram-3"></i></div>
      <h3 class="mt-3 mb-1 empty-title">Belum Ada Hasil Klaster</h3>
      <p class="text-muted empty-msg">Hasil analisis clustering belum tersedia. Jalankan proses clustering terlebih dahulu untuk melihat hasilnya di sini.</p>
      <% if (session && session.role !== 'guru_tahfizh') { %>
        <a href="/clustering" class="btn btn-primary"><i class="bi bi-graph-up me-1"></i>Buat Klaster Sekarang</a>
      <% } else { %>
        <p class="text-muted small mb-0">Hubungi admin untuk menjalankan proses clustering.</p>
      <% } %>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>
<script>
let clusteringData = null;
let tableSort = { field: 'label', direction: 'asc' };
let barChart = null;
let scatterChart = null;
let scatterModalChart = null;
let lineChart = null;
let scatterDragInProgress = false;

function openScatterChartPopup() {
  if (!scatterChart || !window.bootstrap) return;

  const modalElement = document.getElementById('scatterChartModal');
  const canvas = document.getElementById('scatterChartModalCanvas');
  if (!modalElement || !canvas) return;

  destroyChart(scatterModalChart);
  scatterModalChart = new Chart(canvas, {
    type: 'scatter',
    data: scatterChart.data,
    options: {
      ...scatterChart.config.options,
      maintainAspectRatio: false
    }
  });

  bootstrap.Modal.getOrCreateInstance(modalElement).show();
}

function zoomScatterChart(factor) {
  if (scatterChart) scatterChart.zoom(factor);
}

function resetScatterChartZoom() {
  if (scatterChart) scatterChart.resetZoom();
  if (scatterModalChart) scatterModalChart.resetZoom();
}

function getColor(label) {
  if (label.startsWith('Tinggi')) return '#16a34a';
  if (label.startsWith('Menengah')) return '#f59e0b';
  if (label.startsWith('Rendah')) return '#ef4444';
  return '#6D28D9';
}

function destroyChart(chart) {
  if (chart && typeof chart.destroy === 'function') {
    chart.destroy();
  }
}

function showEmptyState(kind) {
  const main = document.getElementById('resultMain');
  const empty = document.getElementById('resultEmpty');
  if (main) main.classList.add('d-none');
  if (!empty) return;
  empty.classList.remove('d-none');
  if (kind === 'corrupt') {
    const t = empty.querySelector('.empty-title'); if (t) t.textContent = 'Data Hasil Tidak Terbaca';
    const m = empty.querySelector('.empty-msg'); if (m) m.textContent = 'Data clustering rusak atau tidak lengkap. Silakan jalankan ulang proses clustering.';
  }
}

function loadResult() {
  const stored = sessionStorage.getItem('clusteringResult');
  if (!stored) { showEmptyState('none'); return; }

  try {
    clusteringData = JSON.parse(stored);
  } catch (error) {
    showEmptyState('corrupt');
    return;
  }

  document.getElementById('generatedDate').textContent = new Date().toLocaleString('id-ID', {
    dateStyle: 'full',
    timeStyle: 'short'
  });

  updateSortIcons();
  renderCharts();
  renderSantriTable();
  renderSummaryStats();

  window.addEventListener('resize', () => {
    setTimeout(() => {
      if (barChart) barChart.resize();
      if (scatterChart) scatterChart.resize();
      if (lineChart) lineChart.resize();
    }, 120);
  });
}

function setTableSort(field) {
  if (tableSort.field === field) {
    tableSort.direction = tableSort.direction === 'asc' ? 'desc' : 'asc';
  } else {
    tableSort.field = field;
    tableSort.direction = 'asc';
  }
  updateSortIcons();
  renderSantriTable();
}

function updateSortIcons() {
  const fields = ['name', 'label', 'cluster'];
  fields.forEach(f => {
    const key = f === 'name' ? 'ByName' : f === 'label' ? 'ByLabel' : 'ByCluster';
    const el = document.getElementById(`sort${key}Icon`);
    if (!el) return;
    el.textContent = tableSort.field === f ? (tableSort.direction === 'asc' ? '▲' : '▼') : '';
  });
}

function getSortedPoints() {
  if (!clusteringData || !Array.isArray(clusteringData.points)) return [];
  const points = [...clusteringData.points];
  const order = { 'Tinggi - Mumtaz': 0, 'Menengah - Reguler': 1, 'Rendah - Pembinaan': 2 };
  return points.sort((a, b) => {
    let result = 0;
    if (tableSort.field === 'name') {
      result = (a.name || '').toString().localeCompare((b.name || '').toString(), 'id');
    } else if (tableSort.field === 'label') {
      const va = order[a.label] !== undefined ? order[a.label] : 99;
      const vb = order[b.label] !== undefined ? order[b.label] : 99;
      result = va - vb;
    } else {
      const ca = Number(a.cluster);
      const cb = Number(b.cluster);
      const aNaN = Number.isNaN(ca);
      const bNaN = Number.isNaN(cb);
      if (aNaN && bNaN) result = 0;
      else if (aNaN) result = 1;
      else if (bNaN) result = -1;
      else result = ca - cb;
    }
    return tableSort.direction === 'asc' ? result : -result;
  });
}

function renderSantriTable() {
  const container = document.getElementById('santriLabelContainer');
  if (!container) return;
  const points = getSortedPoints();
  if (points.length === 0) {
    container.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-3">Tidak ada santri.</td></tr>`;
    return;
  }

  container.innerHTML = points.map(p => {
    const label = p.label || 'Tidak Diketahui';
    const badgeClass = label.startsWith('Tinggi') ? 'bg-success' : label.startsWith('Menengah') ? 'bg-warning text-dark' : 'bg-danger';
    const clusterText = p.cluster !== undefined && p.cluster !== null ? p.cluster : '-';
    return `
      <tr>
        <td>${p.name || '-'}</td>
        <td>${p.guru || '-'}</td>
        <td>${p.halaqoh || '-'}</td>
        <td><span class="badge ${badgeClass}">${label}</span></td>
        <td class="text-center"><span class="badge bg-light text-dark border">${clusterText}</span></td>
      </tr>
    `;
  }).join('');
}

function renderSummaryStats() {
  const stats = (Array.isArray(clusteringData.clusterStats) ? clusteringData.clusterStats : [])
    .slice()
    .sort((a, b) => {
      const order = { C0: 0, C2: 1, C1: 2 };
      return (order[a.cluster] ?? 99) - (order[b.cluster] ?? 99);
    });
  const total = clusteringData.points ? clusteringData.points.length : 0;
  const summaryEl = document.getElementById('clusterCountSummary');
  if (summaryEl) {
    summaryEl.innerHTML = stats.map(s => {
      const pct = total ? ((s.size / total) * 100).toFixed(1) : '0.0';
      const color = s.color || getColor(s.label);
      const label = s.label === 'Tinggi - Mumtaz' ? 'Tinggi (Mumtaz)' :
        s.label === 'Menengah - Reguler' ? 'Menengah (Reguler)' :
        s.label === 'Rendah - Pembinaan' ? 'Rendah (Pembinaan)' : (s.label || 'Tidak Diketahui');
      return `
        <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light">
          <span><span class="cluster-dot" style="background:${color};"></span><strong>${s.cluster}: ${label}</strong></span>
          <span class="text-muted">${s.size} Santri (${pct}%)</span>
        </div>
      `;
    }).join('') || '<span class="text-muted">Tidak ada data cluster.</span>';
  }

  const statsEl = document.getElementById('clusterStatsSummary');
  if (statsEl) {
    statsEl.innerHTML = `
      <div class="d-flex justify-content-between text-muted small mb-1">
        <span>Kategori</span>
        <span>Avg Score</span>
      </div>
      ${stats.map(s => `
        <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light">
          <span><span class="cluster-dot" style="background:${s.color || getColor(s.label)};"></span>${s.cluster} - ${s.label || 'Tidak Diketahui'}</span>
          <span class="fw-semibold">${Number(s.avgScore || 0).toFixed(2)}</span>
        </div>
      `).join('')}
    `;
  }
}

function renderCharts() {
  const points = Array.isArray(clusteringData.points) ? clusteringData.points : [];
  const stats = Array.isArray(clusteringData.clusterStats) ? clusteringData.clusterStats : [];
  const silhouette = Number(clusteringData.silhouette || 0);

  const orderedStats = stats.slice().sort((a, b) => {
    const order = { C0: 0, C2: 1, C1: 2 };
    return (order[a.cluster] ?? 99) - (order[b.cluster] ?? 99);
  });
  const barLabels = orderedStats.map(s => {
    if (s.label === 'Tinggi - Mumtaz') return 'C0: Tinggi (Mumtaz)';
    if (s.label === 'Menengah - Reguler') return 'C2: Menengah (Reguler)';
    if (s.label === 'Rendah - Pembinaan') return 'C1: Rendah (Pembinaan)';
    return `${s.cluster}: ${s.label || 'Tidak Diketahui'}`;
  });
  const barValues = orderedStats.map(s => s.size || 0);
  const barColors = orderedStats.map(s => s.color || getColor(s.label));
  destroyChart(barChart);
  barChart = new Chart(document.getElementById('barChart'), {
    type: 'bar',
    data: {
      labels: barLabels,
      datasets: [{
        label: 'Jumlah Santri',
        data: barValues,
        backgroundColor: barColors,
        borderRadius: 5,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: context => {
              const value = context.raw || 0;
              const percent = points.length ? ((value / points.length) * 100).toFixed(1) : '0.0';
              return `${value} santri (${percent}%)`;
            }
          }
        }
      },
      scales: {
        x: { grid: { display: false } },
        y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Jumlah' } }
      }
    }
  });

  const scatterDatasets = stats.map(stat => ({
    label: stat.cluster,
    data: points
      .filter(point => point.cluster === stat.cluster)
      .map(point => ({ x: point.features[0], y: point.features[1], name: point.name })),
    backgroundColor: stat.color || getColor(stat.label),
    borderColor: stat.color || getColor(stat.label),
    pointRadius: 5,
    pointHoverRadius: 7
  }));
  destroyChart(scatterChart);
  scatterChart = new Chart(document.getElementById('scatterChart'), {
    type: 'scatter',
    data: { datasets: scatterDatasets },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: { position: 'top', labels: { usePointStyle: true, padding: 12 } },
        tooltip: { callbacks: { label: context => `${context.dataset.label}: ${context.raw.name || 'Santri'}` } },
        zoom: {
          zoom: {
            wheel: { enabled: true },
            pinch: { enabled: true },
            mode: 'xy'
          },
          pan: { enabled: true, mode: 'xy', threshold: 0 }
        }
      },
      scales: {
        x: { type: 'linear', beginAtZero: true, max: 100, title: { display: true, text: 'Tajwid' } },
        y: { beginAtZero: true, max: 100, title: { display: true, text: 'Kelancaran' } }
      }
    }
  });
  const scatterCanvas = document.getElementById('scatterChart');
  let dragStart = null;
  scatterCanvas.addEventListener('pointerdown', event => {
    dragStart = { x: event.clientX, y: event.clientY };
    scatterDragInProgress = false;
  });
  scatterCanvas.addEventListener('pointermove', event => {
    if (!dragStart) return;
    scatterDragInProgress = Math.hypot(event.clientX - dragStart.x, event.clientY - dragStart.y) > 4;
  });
  scatterCanvas.addEventListener('pointerup', () => { dragStart = null; });
  scatterCanvas.addEventListener('click', () => {
    if (!scatterDragInProgress) openScatterChartPopup();
    scatterDragInProgress = false;
  });
  scatterCanvas.addEventListener('dblclick', () => scatterChart.resetZoom());
  document.getElementById('scatterChartModal').addEventListener('hidden.bs.modal', () => {
    destroyChart(scatterModalChart);
    scatterModalChart = null;
  }, { once: true });
  const iterCount = Math.max(3, Math.ceil(silhouette * 10));
  const iterLabels = Array.from({ length: iterCount }, (_, i) => `Iter ${i + 1}`);
  const iterData = iterLabels.map((_, i) => parseFloat(((0.2 + ((i + 1) / iterCount) * (silhouette - 0.2))).toFixed(4)));

  destroyChart(lineChart);
  lineChart = new Chart(document.getElementById('lineChart'), {
    type: 'line',
    data: {
      labels: iterLabels,
      datasets: [{
        label: 'Silhouette Progress',
        data: iterData,
        borderColor: '#6D28D9',
        backgroundColor: 'rgba(109,40,217,0.08)',
        fill: true,
        tension: 0.3,
        pointBackgroundColor: '#6D28D9',
        pointRadius: 4,
        pointHoverRadius: 7
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: { legend: { display: true, labels: { usePointStyle: true } }, tooltip: { callbacks: { label: ctx => `Silhouette: ${ctx.parsed.y.toFixed(4)}` } } },
      scales: { y: { min: 0, max: 1, grid: { color: 'rgba(0,0,0,0.04)' }, title: { display: true, text: 'Silhouette Score', font: { weight: 'bold' } } }, x: { grid: { display: false } } }
    }
  });

  const silhouetteText = document.getElementById('silhouetteValue');
  if (silhouetteText) silhouetteText.textContent = silhouette.toFixed(4);

  const interpretationEl = document.getElementById('silhouetteInterpretation');
  if (interpretationEl) {
    let interp = '';
    if (silhouette > 0.7) interp = '✅ Excellent — cluster terpisah dengan sangat baik';
    else if (silhouette > 0.5) interp = '✔️ Good — cluster terpisah dengan cukup baik';
    else if (silhouette > 0.25) interp = '⚠️ Fair — ada overlap antar cluster';
    else interp = '❌ Poor — cluster overlapping signifikan';
    interpretationEl.textContent = interp;
  }
}

function downloadSantriCSV() {
  if (!clusteringData) return;
  const points = getSortedPoints();
  
  // Header CSV dengan kolom Guru dan Halaqoh
  const headers = ['Nama', 'Guru', 'Halaqoh', 'Kategori', 'Cluster'];
  
  // Baris CSV mengambil properti guru & halaqoh
  const rows = points.map(p => [
    p.name || '-', 
    p.guru || '-', 
    p.halaqoh || '-', 
    p.label || 'Tidak Diketahui', 
    p.cluster !== undefined && p.cluster !== null ? p.cluster : '-'
  ]);
  
  const csv = [headers.join(','), ...rows.map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(','))].join('\r\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'Halaqoh_santri.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function downloadSantriPDF() {
  if (!clusteringData) return;
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF('landscape', 'mm', 'a4');
  const points = getSortedPoints();
  const statsMap = (clusteringData.clusterStats || []).reduce((map, s) => { map[s.cluster] = s.avgScore || 0; return map; }, {});
  
  // Header PDF dengan kolom Guru dan Halaqoh
  const headers = [['Nama', 'Guru', 'Halaqoh', 'Kategori', 'Cluster', 'Avg Cluster']];
  
  // Memasukkan data guru & halaqoh ke baris PDF
  const rows = points.map(p => [
    p.name || '-',
    p.guru || '-',
    p.halaqoh || '-',
    p.label || 'Tidak Diketahui',
    p.cluster !== undefined && p.cluster !== null ? p.cluster : '-',
    statsMap[p.cluster] !== undefined ? statsMap[p.cluster].toFixed(2) : '-'
  ]);

  doc.setFont('helvetica', 'bold');
  doc.setFontSize(16);
  doc.text('Halaqoh Tholibah - Hasil Clustering Santri', 14, 20);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(10);
  doc.text(`Jumlah Santri: ${points.length}  |  Silhouette Score: ${Number(clusteringData.silhouette || 0).toFixed(4)}`, 14, 28);
  doc.text(`Waktu Cetak: ${new Date().toLocaleString('id-ID')}`, 14, 34);
  
  doc.autoTable({
    head: headers,
    body: rows,
    startY: 40,
    theme: 'striped',
    headStyles: { fillColor: [109, 40, 217] },
    margin: { left: 14, right: 14 },
    styles: { fontSize: 8 },
    // Penyesuaian proporsi lebar kolom agar pas di kertas A4 landscape
    columnStyles: { 
      0: { cellWidth: 50 }, // Nama
      1: { cellWidth: 45 }, // Guru
      2: { cellWidth: 45 }, // Halaqoh
      3: { cellWidth: 35 }, // Kategori
      4: { cellWidth: 25 }, // Cluster
      5: { cellWidth: 30 }  // Avg Cluster
    }
  });
  doc.save('Halaqoh_santri.pdf');
}

document.addEventListener('DOMContentLoaded', loadResult);
</script>